# dtp-tunes — Self-hosted music server
#
# Services:
#   gateway  — public origin (nginx)
#   web      — Next.js Spotify-inspired UI
#   api      — FastAPI + OpenSubsonic
#   worker   — library scanner (same image as api)
#   mongodb  — metadata store

APP_NAME=dtp-tunes

# ---------------------------------------------------------------------------
# Local development (docker compose up)
# ---------------------------------------------------------------------------
APP_PUBLIC_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# Loopback-only diagnostic port for the gateway (not LAN/WAN reachable)
LOCAL_PORT=8080

# ---------------------------------------------------------------------------
# Runtipi / public HTTPS (docker-compose.runtipi.yml overlay)
# ---------------------------------------------------------------------------
# Set your real hostname, then start with:
#   docker compose -f docker-compose.yml -f docker-compose.runtipi.yml up -d --build
#
# The overlay derives:
#   APP_PUBLIC_URL=https://${DTP_TUNES_DOMAIN}
#   CORS_ORIGINS=https://${DTP_TUNES_DOMAIN}
#
# DNS: A record for this hostname → your public IP
# Keep Cloudflare (if used) in DNS-only mode for streaming reliability.
# Do NOT use the Runtipi "Expose app" UI — this stack is standalone; Traefik
# labels in docker-compose.runtipi.yml register the route directly.
DTP_TUNES_DOMAIN=music.example.com

# Admin bootstrap (first run only)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme-admin-password

# 32+ byte secret for session cookies and AES-GCM Subsonic compatibility credentials
APP_ENCRYPTION_KEY=replace-with-a-long-random-secret-key-32b

# MongoDB — shared DTP database; all dtp-tunes collections are prefixed tunes_
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DB=DTP
MONGODB_COLLECTION_PREFIX=tunes_

# Paths inside containers
MUSIC_PATH=/music
CACHE_PATH=/cache

# Scan / media
SCAN_INTERVAL_SECONDS=300
FFMPEG_MAX_CONCURRENT=2
MUSIC_FOLDER_NAME=Music

# API
API_HOST=0.0.0.0
API_PORT=8000

# Session
SESSION_COOKIE_NAME=dtp_tunes_session
SESSION_TTL_SECONDS=604800
